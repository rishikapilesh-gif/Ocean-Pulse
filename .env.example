# Ocean Pulse Environment Configuration
# =====================================
# Copy this file to apps/api/.env for local development
# On Render/Railway, set these as environment variables in the dashboard.

NODE_ENV=development
PORT=3001

# Database
# --------
# For LOCAL development (SQLite — change schema.prisma provider to "sqlite"):
# DATABASE_URL="file:./dev.db"
#
# For RENDER / RAILWAY (PostgreSQL):
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/oceanpulse?schema=public"

# Security
JWT_SECRET="ocean-pulse-secret-key-hackathon-2026-safe"
SESSION_EXPIRY="7d"
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Operational Mode
DEMO_MODE=true
LOG_LEVEL="info"

# Map Provider Configuration
MAP_PROVIDER="leaflet-osm"
MAP_TILE_URL="https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"

# Environmental & Marine Data Providers (Optional)
WEATHER_PROVIDER="simulated"
OCEAN_DATA_PROVIDER="simulated"

# AI Copilot Provider (Optional: "openai", "ollama", or "fallback")
AI_PROVIDER="fallback"
AI_ENDPOINT="http://127.0.0.1:11434/api/generate"
AI_MODEL="qwen2.5"
# AI_API_KEY=
